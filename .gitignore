# Real historical data (parquet) — do not commit
data_store/*
!data_store/.gitkeep

# Staging / processed / external data
data/raw/*
data/processed/*
data/external/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/external/.gitkeep

# Python
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
.venv/
venv/

# OS / IDE
.DS_Store
.idea/
.vscode/

# Secrets — never commit
.env
.env.*
*.pem
credentials.json
