# Market data — never commit real/large assets

data_store/*
!data_store/.gitkeep

data/raw/*
!data/raw/.gitkeep

data/processed/*
!data/processed/.gitkeep

data/external/*
!data/external/.gitkeep

# data/sample/ is intentionally NOT ignored (CI fixtures)

# Secrets — never commit

.env
.env.*
*.pem
credentials.json
secrets/
**/secrets/

# Python

__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
.venv/
venv/

# OS / IDE

.DS_Store
.idea/
.vscode/
